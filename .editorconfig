# EditorConfig: https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,md,toml}]
indent_size = 4

[*.{vue,js,html,css,json,yaml,yml}]
indent_size = 2

[Makefile]
indent_style = tab
